<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WinRust.NotifyBridge"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
  <!--
    Package identity for an executable that lives outside the .msix ("package with external location").
    These three values must match tools\notify-bridge\AppxManifest.xml exactly: Identity\Name, Identity\Publisher
    and Applications\Application\Id. Without the sparse package registered the block is inert and the bridge still
    listens on this build (see tools\notify-bridge.md).
  -->
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=WinRust Notify Bridge"
        packageName="WinRust.NotifyBridge"
        applicationId="WinRustNotifyBridge" />
</assembly>
